{
  "name": "agentamp-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "amp": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "AGENTAMP_ROOT=.tmp/test vitest run --maxWorkers=1",
    "demo": "tsx src/cli.ts demo --env staging --reset",
    "dispatch": "tsx src/cli.ts dispatch --env staging --limit 5",
    "serve": "tsx src/cli.ts serve --env staging",
    "status": "tsx src/cli.ts status --env staging",
    "doctor": "tsx src/cli.ts doctor",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm demo && pnpm doctor"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "license": "MIT"
}
